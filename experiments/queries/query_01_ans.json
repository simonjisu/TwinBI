      "logic": "Join fact_sales with dim_store, filter sales_district = 'North', compute SUM(total_receipts) / COUNT(DISTINCT date_key) by store_name, order descending.",
      "sql": "SELECT ds.store_name, CAST(SUM(fs.total_receipts) * 1.0 / COUNT(DISTINCT fs.date_key) AS DOUBLE) AS avg_daily_sales FROM fact_sales fs JOIN dim_store ds ON fs.store_key = ds.store_key WHERE ds.sales_district = 'North' GROUP BY ds.store_name ORDER BY avg_daily_sales DESC, ds.store_name ASC LIMIT 10",
