[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [2002]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["item_category", "item_class"],
    "filters": [
      {
        "type": "OR",
        "conditions": [
          {
            "type": "AND",
            "conditions": [
              {
                "column": "i_category",
                "operator": "in",
                "value": ["Home", "Men", "Sports"]
              },
              {
                "column": "i_class",
                "operator": "in",
                "value": ["paint", "accessories", "fitness"]
              }
            ]
          },
          {
            "type": "AND",
            "conditions": [
              {
                "column": "i_category",
                "operator": "in",
                "value": ["Shoes", "Jewelry", "Women"]
              },
              {
                "column": "i_class",
                "operator": "in",
                "value": ["mens", "pendants", "swimwear"]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "operation": "roll-up",
    "dimensions": ["i_category", "i_class", "i_brand", "s_store_name", "s_company_name", "d_moy"],
    "measure": {
      "column": "ss_sales_price",
      "aggregation": "sum",
      "alias": "sum_sales"
    }
  },
  {
    "operation": "window_aggregation",
    "measure": {
      "column": "sum_sales",
      "aggregation": "avg",
      "alias": "avg_monthly_sales"
    },
    "partition_by": ["i_category", "i_brand", "s_store_name", "s_company_name"]
  },
  {
    "operation": "slice",
    "dimension": "computed_metric",
    "filter": {
      "column": "deviation_ratio",
      "operator": "greater_than",
      "value": 0.1,
      "formula": "CASE WHEN avg_monthly_sales <> 0 THEN ABS(sum_sales - avg_monthly_sales) / avg_monthly_sales ELSE NULL END"
    }
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "column": "sum_sales - avg_monthly_sales",
        "direction": "ascending"
      },
      {
        "column": "s_store_name",
        "direction": "ascending"
      }
    ]
  },
  {
    "operation": "limit",
    "value": 100
  }
]