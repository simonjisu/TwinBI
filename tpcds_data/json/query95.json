[
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_date",
      "operator": "between",
      "value": ["2000-03-01", "2000-04-30"]
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_state",
      "operator": "equals_to",
      "value": "MT"
    }
  },
  {
    "operation": "slice",
    "dimension": "web_site",
    "filter": {
      "column": "web_company_name",
      "operator": "equals_to",
      "value": "pri"
    }
  },
  {
    "operation": "dice",
    "dimensions": ["date_dim", "customer_address", "web_site"],
    "description": "Apply multiple dimension filters simultaneously"
  },
  {
    "operation": "slice",
    "dimension": "web_sales",
    "filter": {
      "column": "ws_order_number",
      "operator": "exists_in_subquery",
      "value": "orders with multiple warehouse shipments (ws_warehouse_sk differs)"
    }
  },
  {
    "operation": "slice",
    "dimension": "web_sales",
    "filter": {
      "column": "ws_order_number",
      "operator": "not_exists_in",
      "value": "web_returns (no returned orders)"
    }
  },
  {
    "operation": "roll-up",
    "dimensions": [],
    "measures": [
      {
        "name": "order_count",
        "aggregation": "count_distinct",
        "column": "ws_order_number"
      },
      {
        "name": "total_shipping_cost",
        "aggregation": "sum",
        "column": "ws_ext_ship_cost"
      },
      {
        "name": "total_net_profit",
        "aggregation": "sum",
        "column": "ws_net_profit"
      }
    ],
    "description": "Aggregate to highest level (grand total) with no grouping dimensions"
  },
  {
    "operation": "sort",
    "dimension": "order_count",
    "order": "ascending"
  },
  {
    "operation": "limit",
    "value": 100
  }
]