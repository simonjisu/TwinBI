[
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "i_category",
      "operator": "equals_to",
      "value": "Sports"
    }
  },
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "i_class",
      "operator": "equals_to",
      "value": "fitness"
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "equals_to",
      "value": 5
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 2000
    }
  },
  {
    "operation": "dice",
    "dimension": "customer_address_store",
    "filter": {
      "description": "ca_county = s_county AND ca_state = s_state",
      "conditions": [
        {
          "column": "ca_county",
          "operator": "equals_to",
          "column_reference": "s_county"
        },
        {
          "column": "ca_state",
          "operator": "equals_to",
          "column_reference": "s_state"
        }
      ]
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_month_seq",
      "operator": "between",
      "value": "d_month_seq + 1 AND d_month_seq + 3 (for d_year=2000, d_moy=5)"
    }
  },
  {
    "operation": "roll-up",
    "dimension": "revenue_segment",
    "aggregation": {
      "measure": "ss_ext_sales_price",
      "function": "SUM",
      "group_by": ["c_customer_sk"]
    }
  },
  {
    "operation": "roll-up",
    "dimension": "segment",
    "aggregation": {
      "derived_dimension": "CAST((revenue / 50) AS INT)",
      "measure": "num_customers",
      "function": "COUNT",
      "group_by": ["segment"]
    }
  },
  {
    "operation": "sort",
    "dimension": "segment",
    "order": ["segment ASC", "num_customers ASC"]
  },
  {
    "operation": "slice",
    "dimension": "result_set",
    "filter": {
      "column": "LIMIT",
      "operator": "top_n",
      "value": 100
    }
  }
]