[
  {
    "operation": "slice",
    "dimension": "customer_demographics",
    "filter": {
      "column": "cd_gender",
      "operator": "equals_to",
      "value": "M"
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_demographics",
    "filter": {
      "column": "cd_marital_status",
      "operator": "equals_to",
      "value": "D"
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_demographics",
    "filter": {
      "column": "cd_education_status",
      "operator": "equals_to",
      "value": "College"
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 2000
    }
  },
  {
    "operation": "dice",
    "dimension": "store",
    "filter": {
      "column": "s_state",
      "operator": "in",
      "value": ["TN"]
    }
  },
  {
    "operation": "roll-up",
    "dimensions": ["i_item_id", "s_state"],
    "measures": [
      {
        "name": "agg1",
        "function": "avg",
        "column": "ss_quantity"
      },
      {
        "name": "agg2",
        "function": "avg",
        "column": "ss_list_price"
      },
      {
        "name": "agg3",
        "function": "avg",
        "column": "ss_coupon_amt"
      },
      {
        "name": "agg4",
        "function": "avg",
        "column": "ss_sales_price"
      }
    ],
    "hierarchy": ["i_item_id", "s_state"],
    "grouping_function": "rollup"
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "column": "i_item_id",
        "direction": "asc"
      },
      {
        "column": "s_state",
        "direction": "asc"
      }
    ]
  },
  {
    "operation": "limit",
    "value": 100
  }
]