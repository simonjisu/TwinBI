[
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_dom",
      "operator": "between",
      "value": [1, 2]
    }
  },
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [2000, 2001, 2002]
    }
  },
  {
    "operation": "slice",
    "dimension": "household_demographics",
    "filter": {
      "column": "hd_buy_potential",
      "operator": "in",
      "value": [">10000", "0-500"]
    }
  },
  {
    "operation": "slice",
    "dimension": "household_demographics",
    "filter": {
      "column": "hd_vehicle_count",
      "operator": "greater_than",
      "value": 0
    }
  },
  {
    "operation": "slice",
    "dimension": "household_demographics",
    "filter": {
      "column": "hd_dep_count/hd_vehicle_count",
      "operator": "greater_than",
      "value": 1
    }
  },
  {
    "operation": "slice",
    "dimension": "store",
    "filter": {
      "column": "s_county",
      "operator": "equals_to",
      "value": "Williamson County"
    }
  },
  {
    "operation": "roll-up",
    "dimension": ["ss_ticket_number", "ss_customer_sk"],
    "aggregate": {
      "measure": "count",
      "alias": "cnt"
    }
  },
  {
    "operation": "slice",
    "dimension": "aggregated_result",
    "filter": {
      "column": "cnt",
      "operator": "between",
      "value": [1, 5]
    }
  },
  {
    "operation": "drill-down",
    "dimension": "customer",
    "attributes": ["c_last_name", "c_first_name", "c_salutation", "c_preferred_cust_flag"]
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "column": "cnt",
        "direction": "desc"
      },
      {
        "column": "c_last_name",
        "direction": "asc"
      }
    ]
  }
]