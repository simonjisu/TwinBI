[
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "i_category",
      "operator": "equals_to",
      "value": "Men"
    }
  },
  {
    "operation": "dice",
    "dimensions": ["date", "item"],
    "filters": [
      {
        "column": "d_year",
        "operator": "in",
        "value": [2001, 2002]
      },
      {
        "column": "i_category",
        "operator": "equals_to",
        "value": "Men"
      }
    ]
  },
  {
    "operation": "roll-up",
    "dimension": "date",
    "from_level": "date",
    "to_level": "year",
    "group_by": ["d_year", "i_brand_id", "i_class_id", "i_category_id", "i_manufact_id"],
    "measures": ["sales_cnt", "sales_amt"],
    "aggregation_function": "sum"
  },
  {
    "operation": "pivot",
    "dimension": "date",
    "pivot_column": "d_year",
    "compare_values": [2001, 2002],
    "purpose": "year_over_year_comparison"
  },
  {
    "operation": "slice",
    "dimension": "computed_metric",
    "filter": {
      "column": "sales_ratio",
      "operator": "less_than",
      "value": 0.9,
      "computation": "curr_yr.sales_cnt / prev_yr.sales_cnt"
    }
  },
  {
    "operation": "sort",
    "column": "sales_cnt_diff",
    "order": "ascending"
  },
  {
    "operation": "limit",
    "value": 100
  }
]