[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [1999, 2000, 2001]
    },
    "description": "Filter for years 1999, 2000, and 2001"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "in",
      "value": [12, 1],
      "condition": "when d_year in (1999, 2001)"
    },
    "description": "Filter for December (month 12) in 1999 and January (month 1) in 2001, all months in 2000"
  },
  {
    "operation": "dice",
    "dimensions": ["item_category", "item_brand", "call_center", "date"],
    "description": "Select subcube with i_category, i_brand, cc_name, d_year, d_moy dimensions"
  },
  {
    "operation": "roll-up",
    "dimension": "date",
    "hierarchy": "year-month",
    "level": "month",
    "aggregation": {
      "measure": "cs_sales_price",
      "function": "sum",
      "group_by": ["i_category", "i_brand", "cc_name", "d_year", "d_moy"]
    },
    "description": "Aggregate sales at the month level grouped by category, brand, call center, year, and month"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 2000
    },
    "description": "Final filter to keep only year 2000 records"
  },
  {
    "operation": "slice",
    "dimension": "derived_metric",
    "filter": {
      "column": "avg_monthly_sales",
      "operator": "greater_than",
      "value": 0
    },
    "description": "Filter where average monthly sales is greater than 0"
  },
  {
    "operation": "slice",
    "dimension": "derived_metric",
    "filter": {
      "column": "deviation_ratio",
      "operator": "greater_than",
      "value": 0.1,
      "formula": "abs(sum_sales - avg_monthly_sales) / avg_monthly_sales"
    },
    "description": "Filter where deviation from average exceeds 10%"
  }
]