[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 1999
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "equals_to",
      "value": 12
    }
  },
  {
    "operation": "dice",
    "dimension": "customer_demographics",
    "filter": {
      "logical_operator": "OR",
      "conditions": [
        {
          "logical_operator": "AND",
          "conditions": [
            {
              "column": "cd_marital_status",
              "operator": "equals_to",
              "value": "M"
            },
            {
              "column": "cd_education_status",
              "operator": "equals_to",
              "value": "Unknown"
            }
          ]
        },
        {
          "logical_operator": "AND",
          "conditions": [
            {
              "column": "cd_marital_status",
              "operator": "equals_to",
              "value": "W"
            },
            {
              "column": "cd_education_status",
              "operator": "equals_to",
              "value": "Advanced Degree"
            }
          ]
        }
      ]
    }
  },
  {
    "operation": "slice",
    "dimension": "household_demographics",
    "filter": {
      "column": "hd_buy_potential",
      "operator": "like",
      "value": "Unknown%"
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_gmt_offset",
      "operator": "equals_to",
      "value": -7
    }
  },
  {
    "operation": "roll-up",
    "dimensions": [
      "cc_call_center_id",
      "cc_name",
      "cc_manager",
      "cd_marital_status",
      "cd_education_status"
    ],
    "measure": {
      "column": "cr_net_loss",
      "aggregation": "SUM"
    }
  },
  {
    "operation": "sort",
    "measure": "cr_net_loss",
    "aggregation": "SUM",
    "order": "DESC"
  }
]