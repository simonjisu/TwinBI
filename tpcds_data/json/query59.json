[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_month_seq",
      "operator": "between",
      "value": [1196, 1207]
    },
    "description": "Filter for first year period (months 1196-1207)"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_month_seq",
      "operator": "between",
      "value": [1208, 1219]
    },
    "description": "Filter for second year period (months 1208-1219)"
  },
  {
    "operation": "pivot",
    "dimension": "date",
    "pivot_attribute": "d_day_name",
    "measure": "ss_sales_price",
    "aggregation": "sum",
    "description": "Pivot day names (Sunday-Saturday) into separate columns with sales aggregation"
  },
  {
    "operation": "roll-up",
    "dimension": "date",
    "from_level": "day",
    "to_level": "week",
    "group_by": ["d_week_seq", "ss_store_sk"],
    "measure": "ss_sales_price",
    "aggregation": "sum",
    "description": "Aggregate daily sales to weekly level by week sequence and store"
  },
  {
    "operation": "dice",
    "dimensions": ["store", "date"],
    "filters": [
      {
        "dimension": "store",
        "column": "s_store_id",
        "operator": "self_join_match",
        "description": "Match stores across two time periods"
      },
      {
        "dimension": "date",
        "column": "d_week_seq",
        "operator": "offset_match",
        "value": 52,
        "description": "Match weeks with 52-week offset (year-over-year)"
      }
    ],
    "description": "Create cube subset matching same stores and corresponding weeks across two years"
  },
  {
    "operation": "derived_measure",
    "measure_name": "yoy_sales_ratio",
    "calculation": "divide",
    "operands": ["sales_year1", "sales_year2"],
    "for_each_day": ["sun", "mon", "tue", "wed", "thu", "fri", "sat"],
    "description": "Calculate year-over-year sales ratios for each day of week"
  },
  {
    "operation": "project",
    "attributes": [
      "s_store_name",
      "s_store_id",
      "d_week_seq",
      "sun_sales_ratio",
      "mon_sales_ratio",
      "tue_sales_ratio",
      "wed_sales_ratio",
      "thu_sales_ratio",
      "fri_sales_ratio",
      "sat_sales_ratio"
    ],
    "description": "Select final output columns"
  },
  {
    "operation": "sort",
    "order_by": [
      {"column": "s_store_name", "direction": "asc"},
      {"column": "s_store_id", "direction": "asc"},
      {"column": "d_week_seq", "direction": "asc"}
    ],
    "description": "Order results by store name, store ID, and week sequence"
  },
  {
    "operation": "top_n",
    "n": 100,
    "description": "Limit output to top 100 rows"
  }
]