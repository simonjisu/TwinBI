[
  {
    "operation": "slice",
    "dimension": "item_category",
    "filter": {
      "column": "i_category",
      "operator": "in",
      "value": ["Books"]
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 1999
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "equals_to",
      "value": 3
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_gmt_offset",
      "operator": "equals_to",
      "value": -5
    }
  },
  {
    "operation": "dice",
    "dimensions": ["i_manufact_id", "sales_channel"],
    "description": "Select manufacturer and sales channel dimensions while filtering on Books category, March 1999, and GMT offset -5"
  },
  {
    "operation": "roll-up",
    "dimension": "i_manufact_id",
    "aggregation": {
      "measure": "ext_sales_price",
      "function": "sum",
      "alias": "total_sales"
    },
    "description": "Aggregate sales by manufacturer across all three sales channels (store, catalog, web)"
  },
  {
    "operation": "sort",
    "dimension": "total_sales",
    "order": "ascending"
  },
  {
    "operation": "top-n",
    "limit": 100,
    "description": "Return top 100 results based on sort order"
  }
]