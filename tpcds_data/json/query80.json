[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_date",
      "operator": "between",
      "value": ["2000-08-26", "2000-09-25"]
    }
  },
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "i_current_price",
      "operator": "greater_than",
      "value": 50
    }
  },
  {
    "operation": "slice",
    "dimension": "promotion",
    "filter": {
      "column": "p_channel_tv",
      "operator": "equals_to",
      "value": "N"
    }
  },
  {
    "operation": "dice",
    "dimensions": ["channel", "store_id", "catalog_page_id", "web_site_id"],
    "description": "Creating cube subset across multiple sales channels"
  },
  {
    "operation": "aggregation",
    "measures": [
      {
        "name": "sales",
        "function": "sum",
        "expression": "ext_sales_price"
      },
      {
        "name": "returns",
        "function": "sum",
        "expression": "COALESCE(return_amt, 0)"
      },
      {
        "name": "profit",
        "function": "sum",
        "expression": "net_profit - COALESCE(net_loss, 0)"
      }
    ],
    "group_by": ["channel", "id"]
  },
  {
    "operation": "roll-up",
    "dimensions": ["channel", "id"],
    "hierarchy": ["channel", "id"],
    "description": "ROLLUP operation creating subtotals at channel level and grand total"
  },
  {
    "operation": "sort",
    "order_by": [
      {"column": "channel", "direction": "ascending"},
      {"column": "id", "direction": "ascending"}
    ]
  },
  {
    "operation": "limit",
    "row_count": 100
  }
]