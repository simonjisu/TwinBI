[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_month_seq",
      "operator": "between",
      "value": [1222, 1233]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["warehouse", "ship_mode", "web_site"],
    "filters": [
      {
        "column": "w_warehouse_sk",
        "operator": "equals",
        "value": "ws_warehouse_sk"
      },
      {
        "column": "sm_ship_mode_sk",
        "operator": "equals",
        "value": "ws_ship_mode_sk"
      },
      {
        "column": "web_site_sk",
        "operator": "equals",
        "value": "ws_web_site_sk"
      }
    ]
  },
  {
    "operation": "roll-up",
    "dimensions": ["warehouse_name", "ship_mode_type", "web_name"],
    "aggregations": [
      {
        "measure": "order_count",
        "function": "sum",
        "condition": "ws_ship_date_sk - ws_sold_date_sk <= 30",
        "alias": "30 days"
      },
      {
        "measure": "order_count",
        "function": "sum",
        "condition": "ws_ship_date_sk - ws_sold_date_sk > 30 AND ws_ship_date_sk - ws_sold_date_sk <= 60",
        "alias": "31-60 days"
      },
      {
        "measure": "order_count",
        "function": "sum",
        "condition": "ws_ship_date_sk - ws_sold_date_sk > 60 AND ws_ship_date_sk - ws_sold_date_sk <= 90",
        "alias": "61-90 days"
      },
      {
        "measure": "order_count",
        "function": "sum",
        "condition": "ws_ship_date_sk - ws_sold_date_sk > 90 AND ws_ship_date_sk - ws_sold_date_sk <= 120",
        "alias": "91-120 days"
      },
      {
        "measure": "order_count",
        "function": "sum",
        "condition": "ws_ship_date_sk - ws_sold_date_sk > 120",
        "alias": ">120 days"
      }
    ],
    "group_by": [
      "substr(w_warehouse_name, 1, 20)",
      "sm_type",
      "web_name"
    ]
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "column": "substr(w_warehouse_name, 1, 20)",
        "direction": "ascending"
      },
      {
        "column": "sm_type",
        "direction": "ascending"
      },
      {
        "column": "web_name",
        "direction": "ascending"
      }
    ]
  },
  {
    "operation": "limit",
    "value": 100
  }
]