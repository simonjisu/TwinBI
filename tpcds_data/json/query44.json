[
  {
    "operation": "slice",
    "dimension": "store",
    "filter": {
      "column": "ss_store_sk",
      "operator": "equals_to",
      "value": 4
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_demographics",
    "filter": {
      "column": "ss_cdemo_sk",
      "operator": "is_null",
      "value": null
    },
    "note": "Applied to subquery for baseline calculation"
  },
  {
    "operation": "roll-up",
    "dimension": "item",
    "aggregation": {
      "function": "AVG",
      "measure": "ss_net_profit",
      "group_by": ["ss_item_sk"]
    }
  },
  {
    "operation": "dice",
    "filter": {
      "column": "avg_net_profit",
      "operator": "greater_than",
      "value": "0.9 * baseline_avg",
      "description": "Filter items with avg profit > 90% of baseline"
    }
  },
  {
    "operation": "rank",
    "dimension": "item",
    "ranking": {
      "order_by": "avg_net_profit",
      "direction": "ASC",
      "rank_column": "rnk"
    },
    "note": "For best performing items"
  },
  {
    "operation": "rank",
    "dimension": "item",
    "ranking": {
      "order_by": "avg_net_profit",
      "direction": "DESC",
      "rank_column": "rnk"
    },
    "note": "For worst performing items"
  },
  {
    "operation": "slice",
    "dimension": "rank",
    "filter": {
      "column": "rnk",
      "operator": "less_than",
      "value": 11
    },
    "note": "Top 10 for both ascending and descending rankings"
  },
  {
    "operation": "drill-across",
    "dimension": "item",
    "description": "Join ranked results with item dimension to retrieve product names"
  },
  {
    "operation": "sort",
    "order_by": "rnk",
    "direction": "ASC"
  },
  {
    "operation": "limit",
    "value": 100
  }
]