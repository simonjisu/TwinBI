[
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_dow",
      "operator": "equals",
      "value": 1
    }
  },
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [2000, 2001, 2002]
    }
  },
  {
    "operation": "slice",
    "dimension": "store",
    "filter": {
      "column": "s_number_employees",
      "operator": "between",
      "value": [200, 295]
    }
  },
  {
    "operation": "dice",
    "dimension": "household_demographics",
    "filter": {
      "logical_operator": "or",
      "conditions": [
        {
          "column": "hd_dep_count",
          "operator": "equals",
          "value": 8
        },
        {
          "column": "hd_vehicle_count",
          "operator": "greater_than",
          "value": 4
        }
      ]
    }
  },
  {
    "operation": "roll-up",
    "dimensions": ["ss_ticket_number", "ss_customer_sk", "ss_addr_sk", "s_city"],
    "measures": [
      {
        "column": "ss_coupon_amt",
        "aggregation": "sum",
        "alias": "amt"
      },
      {
        "column": "ss_net_profit",
        "aggregation": "sum",
        "alias": "profit"
      }
    ]
  },
  {
    "operation": "projection",
    "attributes": [
      "c_last_name",
      "c_first_name",
      "s_city",
      "ss_ticket_number",
      "amt",
      "profit"
    ]
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "column": "c_last_name",
        "direction": "asc"
      },
      {
        "column": "c_first_name",
        "direction": "asc"
      },
      {
        "column": "s_city",
        "direction": "asc"
      },
      {
        "column": "profit",
        "direction": "asc"
      }
    ]
  },
  {
    "operation": "limit",
    "value": 100
  }
]