[
  {
    "operation": "slice",
    "dimension": "item_current_price",
    "filter": {
      "column": "i_current_price",
      "operator": "between",
      "value": [20, 50]
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_date",
      "operator": "between",
      "value": ["1999-03-06", "1999-05-05"]
    }
  },
  {
    "operation": "slice",
    "dimension": "manufacturer",
    "filter": {
      "column": "i_manufact_id",
      "operator": "in",
      "value": [843, 815, 850, 840]
    }
  },
  {
    "operation": "slice",
    "dimension": "inventory_quantity",
    "filter": {
      "column": "inv_quantity_on_hand",
      "operator": "between",
      "value": [100, 500]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["item_current_price", "date", "manufacturer", "inventory_quantity"],
    "description": "Multi-dimensional filtering across price, date, manufacturer, and inventory quantity"
  },
  {
    "operation": "roll-up",
    "dimensions": ["i_item_id", "i_item_desc", "i_current_price"],
    "aggregation": "group_by",
    "description": "Aggregating data at the item level with item_id, description, and current price"
  },
  {
    "operation": "project",
    "attributes": ["i_item_id", "i_item_desc", "i_current_price"],
    "description": "Selecting specific attributes for final output"
  },
  {
    "operation": "sort",
    "dimension": "i_item_id",
    "order": "ascending"
  },
  {
    "operation": "limit",
    "value": 100
  }
]