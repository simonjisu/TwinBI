[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 2000
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_state",
      "operator": "equals_to",
      "value": "IN"
    }
  },
  {
    "operation": "roll-up",
    "dimension": ["wr_returning_customer_sk", "ca_state"],
    "measure": {
      "column": "wr_return_amt",
      "aggregation": "sum",
      "alias": "ctr_total_return"
    }
  },
  {
    "operation": "dice",
    "filter": {
      "type": "subquery_comparison",
      "description": "ctr_total_return > AVG(ctr_total_return) * 1.2 within same state",
      "column": "ctr_total_return",
      "operator": "greater_than",
      "value": "state_average * 1.2"
    }
  },
  {
    "operation": "projection",
    "columns": [
      "c_customer_id",
      "c_salutation",
      "c_first_name",
      "c_last_name",
      "c_preferred_cust_flag",
      "c_birth_day",
      "c_birth_month",
      "c_birth_year",
      "c_birth_country",
      "c_login",
      "c_email_address",
      "c_last_review_date",
      "ctr_total_return"
    ]
  },
  {
    "operation": "sort",
    "order_by": [
      "c_customer_id",
      "c_salutation",
      "c_first_name",
      "c_last_name",
      "c_preferred_cust_flag",
      "c_birth_day",
