[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_date",
      "operator": "between",
      "value": ["2000-05-11", "2000-06-10"]
    }
  },
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "i_category",
      "operator": "in",
      "value": ["Home", "Men", "Women"]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["item", "date"],
    "filters": [
      {
        "column": "i_category",
        "operator": "in",
        "value": ["Home", "Men", "Women"]
      },
      {
        "column": "d_date",
        "operator": "between",
        "value": ["2000-05-11", "2000-06-10"]
      }
    ]
  },
  {
    "operation": "roll-up",
    "dimension": "item",
    "from_level": "item_id",
    "to_level": "class",
    "group_by": ["i_item_id", "i_item_desc", "i_category", "i_class", "i_current_price"],
    "measure": {
      "column": "ws_ext_sales_price",
      "aggregation": "sum",
      "alias": "itemrevenue"
    }
  },
  {
    "operation": "pivot",
    "measure": "itemrevenue",
    "window_function": {
      "type": "ratio_to_report",
      "partition_by": ["i_class"],
      "calculation": "sum(ws_ext_sales_price) * 100 / sum(sum(ws_ext_sales_price)) over (partition by i_class)",
      "alias": "revenueratio"
    }
  },
  {
    "operation": "sort",
    "order_by": [
      {"column": "i_category", "direction": "asc"},
      {"column": "i_class", "direction": "asc"},
      {"column": "i_item_id", "direction": "asc"},
      {"column": "i_item_desc", "direction": "asc"},
      {"column": "revenueratio", "direction": "asc"}
    ]
  },
  {
    "operation": "limit",
    "top_n": 100
  }
]