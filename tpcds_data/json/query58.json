[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_date",
      "operator": "equals_to",
      "value": "2002-02-25"
    },
    "description": "Filter to get the specific week sequence for the target date"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_week_seq",
      "operator": "in",
      "value": "week_seq_from_2002-02-25"
    },
    "description": "Filter all dates belonging to the same week sequence"
  },
  {
    "operation": "dice",
    "dimensions": ["item", "sales_channel"],
    "filters": [
      {
        "column": "sales_channel",
        "operator": "in",
        "value": ["store_sales", "catalog_sales", "web_sales"]
      }
    ],
    "description": "Create subcubes for each sales channel"
  },
  {
    "operation": "roll-up",
    "dimension": "item",
    "aggregation": {
      "measure": "ext_sales_price",
      "function": "sum",
      "group_by": ["item_id", "sales_channel"]
    },
    "description": "Aggregate sales by item_id for each sales channel"
  },
  {
    "operation": "pivot",
    "row_dimension": "item_id",
    "column_dimension": "sales_channel",
    "measure": "sum_ext_sales_price",
    "description": "Pivot sales channels to columns (ss_item_rev, cs_item_rev, ws_item_rev)"
  },
  {
    "operation": "slice",
    "dimension": "revenue_balance",
    "filter": {
      "column": "revenue_variance",
      "operator": "between",
      "value": "0.9 to 1.1 ratio across all channels"
    },
    "description": "Filter items where revenues across channels are within 10% of each other"
  },
  {
    "operation": "project",
    "measures": [
      "item_id",
      "ss_item_rev",
      "cs_item_rev",
      "ws_item_rev",
      "ss_dev (calculated)",
      "cs_dev (calculated)",
      "ws_dev (calculated)",
      "average (calculated)"
    ],
    "description": "Calculate deviation percentages and averages"
  },
  {
    "operation": "sort",
    "dimensions": ["item_id", "ss_item_rev"],
    "order": "ascending",
    "description": "Order results by item_id and store sales revenue"
  },
  {
    "operation": "slice",
    "dimension": "result_set",
    "filter": {
      "column": "row_number",
      "operator": "less_than_or_equal",
      "value": 100
    },
    "description": "Limit to top 100 results"
  }
]