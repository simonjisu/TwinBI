[
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_dom",
      "operator": "in_range",
      "value": "1-3 OR 25-28"
    }
  },
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [1999, 2000, 2001]
    }
  },
  {
    "operation": "slice",
    "dimension": "household_demographics",
    "filter": {
      "column": "hd_buy_potential",
      "operator": "in",
      "value": [">10000", "unknown"]
    }
  },
  {
    "operation": "slice",
    "dimension": "household_demographics",
    "filter": {
      "column": "hd_vehicle_count",
      "operator": "greater_than",
      "value": 0
    }
  },
  {
    "operation": "slice",
    "dimension": "household_demographics",
    "filter": {
      "column": "hd_dep_count/hd_vehicle_count",
      "operator": "greater_than",
      "value": 1.2
    }
  },
  {
    "operation": "slice",
    "dimension": "store",
    "filter": {
      "column": "s_county",
      "operator": "equals",
      "value": "Williamson County"
    }
  },
  {
    "operation": "roll-up",
    "dimension": "store_sales",
    "group_by": ["ss_ticket_number", "ss_customer_sk"],
    "measure": {
      "aggregation": "count",
      "alias": "cnt"
    }
  },
  {
    "operation": "slice",
    "dimension": "aggregated_result",
    "filter": {
      "column": "cnt",
      "operator": "between",
      "value": [15, 20]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["customer"],
    "selected_attributes": [
      "c_last_name",
      "c_first_name",
      "c_salutation",
      "c_preferred_cust_flag",
      "ss_ticket_number",
      "cnt"
    ]
  },
  {
    "operation": "sort",
    "order_by": [
      {"column": "c_last_name", "direction": "ASC"},
      {"column": "c_first_name", "direction": "ASC"},
      {"column": "c_salutation", "direction": "ASC"},
      {"column": "c_preferred_cust_flag", "direction": "DESC"}
    ]
  }
]