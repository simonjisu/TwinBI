[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_month_seq",
      "operator": "between",
      "value": [1200, 1211]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["warehouse", "ship_mode", "call_center"],
    "filters": [
      {
        "column": "cs_ship_date_sk",
        "operator": "equals",
        "value": "d_date_sk"
      },
      {
        "column": "cs_warehouse_sk",
        "operator": "equals",
        "value": "w_warehouse_sk"
      },
      {
        "column": "cs_ship_mode_sk",
        "operator": "equals",
        "value": "sm_ship_mode_sk"
      },
      {
        "column": "cs_call_center_sk",
        "operator": "equals",
        "value": "cc_call_center_sk"
      }
    ]
  },
  {
    "operation": "roll-up",
    "dimensions": [
      {
        "name": "warehouse",
        "attribute": "w_warehouse_name",
        "transformation": "substr(w_warehouse_name, 1, 20)"
      },
      {
        "name": "ship_mode",
        "attribute": "sm_type"
      },
      {
        "name": "call_center",
        "attribute": "cc_name"
      }
    ],
    "measures": [
      {
        "name": "30 days",
        "aggregation": "sum",
        "expression": "CASE WHEN (cs_ship_date_sk - cs_sold_date_sk <= 30) THEN 1 ELSE 0 END"
      },
      {
        "name": "31-60 days",
        "aggregation": "sum",
        "expression": "CASE WHEN (cs_ship_date_sk - cs_sold_date_sk > 30) AND (cs_ship_date_sk - cs_sold_date_sk <= 60) THEN 1 ELSE 0 END"
      },
      {
        "name": "61-90 days",
        "aggregation": "sum",
        "expression": "CASE WHEN (cs_ship_date_sk - cs_sold_date_sk > 60) AND (cs_ship_date_sk - cs_sold_date_sk <= 90) THEN 1 ELSE 0 END"
      },
      {
        "name": "91-120 days",
        "aggregation": "sum",
        "expression": "CASE WHEN (cs_ship_date_sk - cs_sold_date_sk > 90) AND (cs_ship_date_sk - cs_sold_date_sk <= 120) THEN 1 ELSE 0 END"
      },
      {
        "name": ">120 days",
        "aggregation": "sum",
        "expression": "CASE WHEN (cs_ship_date_sk - cs_sold_date_sk > 120) THEN 1 ELSE 0 END"
      }
    ]
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "column": "substr(w_warehouse_name, 1, 20)",
        "direction": "ascending"
      },
      {
        "column": "sm_type",
        "direction": "ascending"
      },
      {
        "column": "cc_name",
        "direction": "ascending"
      }
    ]
  },
  {
    "operation": "limit",
    "value": 100
  }
]