[
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "i_color",
      "operator": "in",
      "value": ["firebrick", "rosy", "white"]
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 1998
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "equals_to",
      "value": 3
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_gmt_offset",
      "operator": "equals_to",
      "value": -6
    }
  },
  {
    "operation": "dice",
    "dimensions": ["item", "date", "customer_address"],
    "description": "Multi-dimensional filtering on item color, year, month, and GMT offset"
  },
  {
    "operation": "roll-up",
    "dimension": "item",
    "from_level": "item_sk",
    "to_level": "item_id",
    "aggregate_function": "sum",
    "measure": "ext_sales_price"
  },
  {
    "operation": "roll-up",
    "dimension": "sales_channel",
    "from_level": ["store_sales", "catalog_sales", "web_sales"],
    "to_level": "all_channels",
    "aggregate_function": "sum",
    "measure": "total_sales",
    "description": "Union and aggregation across all sales channels"
  },
  {
    "operation": "sort",
    "dimension": "measure",
    "order_by": "total_sales",
    "direction": "ascending"
  },
  {
    "operation": "top_n",
    "limit": 100,
    "description": "Select top 100 items by total sales"
  }
]