[
  {
    "operation": "slice",
    "dimension": "customer_demographics",
    "filter": {
      "column": "cd_gender",
      "operator": "equals_to",
      "value": "F"
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_demographics",
    "filter": {
      "column": "cd_marital_status",
      "operator": "equals_to",
      "value": "W"
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_demographics",
    "filter": {
      "column": "cd_education_status",
      "operator": "equals_to",
      "value": "Secondary"
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 2000
    }
  },
  {
    "operation": "dice",
    "dimension": "promotion",
    "filter": {
      "logical_operator": "OR",
      "conditions": [
        {
          "column": "p_channel_email",
          "operator": "equals_to",
          "value": "N"
        },
        {
          "column": "p_channel_event",
          "operator": "equals_to",
          "value": "N"
        }
      ]
    }
  },
  {
    "operation": "roll_up",
    "dimension": "item",
    "level": "i_item_id",
    "aggregations": [
      {
        "measure": "cs_quantity",
        "function": "AVG",
        "alias": "agg1"
      },
      {
        "measure": "cs_list_price",
        "function": "AVG",
        "alias": "agg2"
      },
      {
        "measure": "cs_coupon_amt",
        "function": "AVG",
        "alias": "agg3"
      },
      {
        "measure": "cs_sales_price",
        "function": "AVG",
        "alias": "agg4"
      }
    ]
  },
  {
    "operation": "sort",
    "dimension": "item",
    "order_by": [
      {
        "column": "i_item_id",
        "direction": "ASC"
      }
    ]
  },
  {
    "operation": "limit",
    "rows": 100
  }
]