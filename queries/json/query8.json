{
  "query_description": "Store sales analysis by store name for specific customer zip codes in Q2 2000",
  "olap_operations": [
    {
      "operation": "slice",
      "sequence": 1,
      "dimension": "date_dim",
      "conditions": [
        {
          "attribute": "d_year",
          "operator": "=",
          "value": 2000
        },
        {
          "attribute": "d_qoy",
          "operator": "=",
          "value": 2
        }
      ],
      "description": "Filter data to Q2 2000"
    },
    {
      "operation": "slice",
      "sequence": 2,
      "dimension": "customer_address",
      "conditions": [
        {
          "attribute": "ca_zip",
          "operator": "IN",
          "value": ["67436", "26121", "38443", "..."],
          "note": "List of 300+ specific zip codes (first 5 digits)"
        }
      ],
      "description": "Filter to specific customer zip codes"
    },
    {
      "operation": "slice",
      "sequence": 3,
      "dimension": "customer",
      "conditions": [
        {
          "attribute": "c_preferred_cust_flag",
          "operator": "=",
          "value": "Y"
        }
      ],
      "description": "Filter to preferred customers only"
    },
    {
      "operation": "dice",
      "sequence": 4,
      "dimensions": [
        "customer_address",
        "customer"
      ],
      "conditions": [
        {
          "attribute": "ca_address_sk",
          "operator": "=",
          "attribute2": "c_current_addr_sk",
          "description": "Join condition on address key"
        }
      ],
      "having_condition": {
        "aggregate": "COUNT(*)",
        "operator": ">",
        "value": 10,
        "description": "Zip codes with more than 10 preferred customers"
      },
      "description": "Create subcube of valid zip codes with sufficient preferred customers"
    },
    {
      "operation": "slice",
      "sequence": 5,
      "dimension": "store",
      "conditions": [
        {
          "attribute": "SUBSTR(s_zip, 1, 2)",
          "operator": "=",
          "attribute2": "SUBSTR(ca_zip, 1, 2)",
          "description": "Match first 2 digits of store zip with valid customer zip codes"
        }
      ],
      "description": "Filter stores to those in zip code regions matching valid customer addresses"
    },
    {
      "operation": "roll-up",
      "sequence": 6,
      "aggregate_function": "SUM",
      "measure": "ss_net_profit",
      "group_by_dimensions": [
        "s_store_name"
      ],
      "removed_dimensions": [
        "ss_sold_date_sk",
        "d_date_sk",
        "d_year",
        "d_qoy",
        "ss_store_sk",
        "s_store_sk",
        "s_zip",
        "ca_zip",
        "c_preferred_cust_flag"
      ],
      "description": "Aggregate net profit by store name, rolling up from transaction level to store level"
    },
    {
      "operation": "sort",
      "sequence": 7,
      "order_by": [
        {
          "attribute": "s_store_name",
          "direction": "ASC"
        }
      ],
      "description": "Order results by store name alphabetically"
    },
    {
      "operation": "top-n",
      "sequence": 8,
      "limit": 100,
      "description": "Return top 100 results"
    }
  ],
  "final_result": {
    "dimensions": ["s_store_name"],
    "measures": ["SUM(ss_net_profit)"],
    "granularity": "store level"
  }
}