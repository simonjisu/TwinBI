[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 2000
    }
  },
  {
    "operation": "slice",
    "dimension": "store",
    "filter": {
      "column": "s_state",
      "operator": "in",
      "value": ["TN", "TN", "TN", "TN", "TN", "TN", "TN", "TN"]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["item_category", "item_class"],
    "description": "Select subcube with item category and class dimensions"
  },
  {
    "operation": "roll-up",
    "dimension": "item",
    "from_level": ["i_category", "i_class"],
    "to_level": ["i_category"],
    "aggregation": "ROLLUP",
    "description": "Roll up from (i_category, i_class) to i_category and grand total"
  },
  {
    "operation": "aggregate",
    "measures": [
      {
        "name": "gross_margin",
        "calculation": "SUM(ss_net_profit) / SUM(ss_ext_sales_price)"
      }
    ],
    "group_by": ["i_category", "i_class"],
    "aggregation_type": "ROLLUP"
  },
  {
    "operation": "pivot",
    "description": "Calculate ranking within hierarchical groups using GROUPING sets",
    "ranking": {
      "partition_by": ["GROUPING(i_category) + GROUPING(i_class)", "i_category when GROUPING(i_class) = 0"],
      "order_by": "gross_margin ASC"
    }
  }
]