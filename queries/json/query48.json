[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 1999
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_country",
      "operator": "equals_to",
      "value": "United States"
    }
  },
  {
    "operation": "dice",
    "dimension": "customer_demographics",
    "filter": {
      "logical_operator": "OR",
      "conditions": [
        {
          "logical_operator": "AND",
          "conditions": [
            {
              "column": "cd_marital_status",
              "operator": "equals_to",
              "value": "W"
            },
            {
              "column": "cd_education_status",
              "operator": "equals_to",
              "value": "Secondary"
            }
          ]
        },
        {
          "logical_operator": "AND",
          "conditions": [
            {
              "column": "cd_marital_status",
              "operator": "equals_to",
              "value": "M"
            },
            {
              "column": "cd_education_status",
              "operator": "equals_to",
              "value": "Advanced Degree"
            }
          ]
        },
        {
          "logical_operator": "AND",
          "conditions": [
            {
              "column": "cd_marital_status",
              "operator": "equals_to",
              "value": "D"
            },
            {
              "column": "cd_education_status",
              "operator": "equals_to",
              "value": "2 yr Degree"
            }
          ]
        }
      ]
    }
  },
  {
    "operation": "dice",
    "dimension": "store_sales",
    "filter": {
      "logical_operator": "OR",
      "conditions": [
        {
          "logical_operator": "AND",
          "conditions": [
            {
              "column": "ss_sales_price",
              "operator": "between",
              "value": [100.00, 150.00]
            },
            {
              "column": "ca_state",
              "operator": "in",
              "value": ["TX", "NE", "MO"]
            },
            {
              "column": "ss_net_profit",
              "operator": "between",
              "value": [0, 2000]
            }
          ]
        },
        {
          "logical_operator": "AND",
          "conditions": [
            {
              "column": "ss_sales_price",
              "operator": "between",
              "value": [50.00, 100.00]
            },
            {
              "column": "ca_state",
              "operator": "in",
              "value": ["CO", "TN", "ND"]
            },
            {
              "column": "ss_net_profit",
              "operator": "between",
              "value": [150, 3000]
            }
          ]
        },
        {
          "logical_operator": "AND",
          "conditions": [
            {
              "column": "ss_sales_price",
              "operator": "between",
              "value": [150.00, 200.00]
            },
            {
              "column": "ca_state",
              "operator": "in",
              "value": ["OK", "PA", "CA"]
            },
            {
              "column": "ss_net_profit",
              "operator": "between",
              "value": [50, 25000]
            }
          ]
        }
      ]
    }
  },
  {
    "operation": "roll-up",
    "dimension": "all",
    "aggregation": {
      "function": "SUM",
      "measure": "ss_quantity"
    }
  }
]