[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 2001
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "equals_to",
      "value": 12
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_gmt_offset",
      "operator": "equals_to",
      "value": -7
    }
  },
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "i_category",
      "operator": "equals_to",
      "value": "Books"
    }
  },
  {
    "operation": "slice",
    "dimension": "store",
    "filter": {
      "column": "s_gmt_offset",
      "operator": "equals_to",
      "value": -7
    }
  },
  {
    "operation": "dice",
    "dimensions": ["promotion"],
    "filter": {
      "logical_operator": "OR",
      "conditions": [
        {
          "column": "p_channel_dmail",
          "operator": "equals_to",
          "value": "Y"
        },
        {
          "column": "p_channel_email",
          "operator": "equals_to",
          "value": "Y"
        },
        {
          "column": "p_channel_tv",
          "operator": "equals_to",
          "value": "Y"
        }
      ]
    }
  },
  {
    "operation": "roll-up",
    "dimension": "all_dimensions",
    "aggregation": {
      "function": "SUM",
      "measure": "ss_ext_sales_price",
      "alias": "promotions"
    },
    "note": "Aggregation for promotional sales with promotion filters applied"
  },
  {
    "operation": "roll-up",
    "dimension": "all_dimensions",
    "aggregation": {
      "function": "SUM",
      "measure": "ss_ext_sales_price",
      "alias": "total"
    },
    "note": "Aggregation for all sales without promotion filters"
  },
  {
    "operation": "pivot",
    "compute": {
      "expression": "CAST(promotions AS DECIMAL(15,4)) / CAST(total AS DECIMAL(15,4)) * 100",
      "description": "Calculate percentage of promotional sales to total sales"
    }
  }
]