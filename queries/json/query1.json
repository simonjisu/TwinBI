[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 2001
    }
  },
  {
    "operation": "slice",
    "dimension": "store",
    "filter": {
      "column": "s_state",
      "operator": "equals_to",
      "value": "TN"
    }
  },
  {
    "operation": "roll-up",
    "dimensions": ["sr_customer_sk", "sr_store_sk"],
    "measure": {
      "column": "sr_return_amt",
      "aggregation": "sum",
      "alias": "ctr_total_return"
    }
  },
  {
    "operation": "dice",
    "dimension": "customer_store_return",
    "filter": {
      "column": "ctr_total_return",
      "operator": "greater_than",
      "value": "1.2 * AVG(ctr_total_return) per store",
      "description": "Filter customers whose total return exceeds 120% of the average return for their store"
    }
  },
  {
    "operation": "projection",
    "attributes": ["c_customer_id"],
    "description": "Select only customer ID from the result"
  },
  {
    "operation": "sort",
    "dimension": "customer",
    "order_by": {
      "column": "c_customer_id",
      "direction": "ascending"
    }
  },
  {
    "operation": "limit",
    "row_count": 100,
    "description": "Return top 100 results"
  }
]