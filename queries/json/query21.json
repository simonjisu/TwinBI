[
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "i_current_price",
      "operator": "between",
      "value": [0.99, 1.49]
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_date",
      "operator": "between",
      "value": ["2000-04-13", "2000-06-12"]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["warehouse", "item", "date"],
    "filters": [
      {
        "column": "i_current_price",
        "operator": "between",
        "value": [0.99, 1.49]
      },
      {
        "column": "d_date",
        "operator": "between",
        "value": ["2000-04-13", "2000-06-12"]
      }
    ]
  },
  {
    "operation": "roll-up",
    "dimensions": ["w_warehouse_name", "i_item_id"],
    "measures": [
      {
        "name": "inv_before",
        "aggregation": "sum",
        "expression": "inv_quantity_on_hand WHERE d_date < '2000-05-13'"
      },
      {
        "name": "inv_after",
        "aggregation": "sum",
        "expression": "inv_quantity_on_hand WHERE d_date >= '2000-05-13'"
      }
    ]
  },
  {
    "operation": "slice",
    "dimension": "computed_metric",
    "filter": {
      "column": "inv_after/inv_before",
      "operator": "between",
      "value": [0.6667, 1.5]
    }
  },
  {
    "operation": "sort",
    "dimensions": ["w_warehouse_name", "i_item_id"],
    "order": "ascending"
  },
  {
    "operation": "limit",
    "value": 100
  }
]