[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [1998, 1999, 2000, 2001]
    },
    "context": "frequent_ss_items CTE - filter store sales by year range"
  },
  {
    "operation": "dice",
    "dimensions": ["item", "date"],
    "filters": [
      {
        "column": "ss_sold_date_sk",
        "operator": "equals",
        "value": "d_date_sk"
      },
      {
        "column": "ss_item_sk",
        "operator": "equals",
        "value": "i_item_sk"
      }
    ],
    "context": "frequent_ss_items CTE - multi-dimensional filtering"
  },
  {
    "operation": "roll-up",
    "dimensions": ["item_description", "item_sk", "date"],
    "measure": "count",
    "aggregation": "COUNT(*)",
    "context": "frequent_ss_items CTE - aggregate to item and date level"
  },
  {
    "operation": "slice",
    "dimension": "frequency",
    "filter": {
      "column": "cnt",
      "operator": "greater_than",
      "value": 4
    },
    "context": "frequent_ss_items CTE - filter frequent items"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [1998, 1999, 2000, 2001]
    },
    "context": "max_store_sales CTE - filter by year range"
  },
  {
    "operation": "roll-up",
    "dimensions": ["customer"],
    "measure": "sales",
    "aggregation": "SUM(ss_quantity * ss_sales_price)",
    "context": "max_store_sales CTE - aggregate sales by customer"
  },
  {
    "operation": "roll-up",
    "dimensions": [],
    "measure": "max_sales",
    "aggregation": "MAX(csales)",
    "context": "max_store_sales CTE - find maximum customer sales"
  },
  {
    "operation": "roll-up",
    "dimensions": ["customer"],
    "measure": "sales",
    "aggregation": "SUM(ss_quantity * ss_sales_price)",
    "context": "best_ss_customer CTE - aggregate sales by customer"
  },
  {
    "operation": "slice",
    "dimension": "sales_threshold",
    "filter": {
      "column": "ssales",
      "operator": "greater_than",
      "value": "0.95 * max_store_sales"
    },
    "context": "best_ss_customer CTE - filter top 5% customers"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals",
      "value": 1998
    },
    "context": "Main query - filter catalog sales by year"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "equals",
      "value": 6
    },
    "context": "Main query - filter catalog sales by month"
  },
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "cs_item_sk",
      "operator": "in",
      "value": "frequent_ss_items.item_sk"
    },
    "context": "Main query - filter by frequent items"
  },
  {
    "operation": "slice",
    "dimension": "customer",
    "filter": {
      "column": "cs_bill_customer_sk",
      "operator": "in",
      "value": "best_ss_customer.c_customer_sk"
    },
    "context": "Main query - filter by best customers"
  },
  {
    "operation": "roll-down",
    "dimensions": ["customer_last_name", "customer_first_name"],
    "measure": "sales",
    "aggregation": "SUM(cs_quantity * cs_list_price)",
    "context": "Main query - drill down to customer name level for catalog sales"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals",
      "value": 1998
    },
    "context": "Main query - filter web sales by year"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "equals",
      "value": 6
    },
    "context": "Main query - filter web sales by month"
  },
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "ws_item_sk",
      "operator": "in",
      "value": "frequent_ss_items.item_sk"
    },
    "context": "Main query - filter by frequent items"
  },
  {
    "operation": "slice",
    "dimension": "customer",
    "filter": {
      "column": "ws_bill_customer_sk",
      "operator": "in",
      "value": "best_ss_customer.c_customer_sk"
    },
    "context": "Main query - filter by best customers"
  },
  {
    "operation": "roll-down",
    "dimensions": ["customer_last_name", "customer_first_name"],
    "measure": "sales",
    "aggregation": "SUM(ws_quantity * ws_list_price)",
    "context": "Main query - drill down to customer name level for web sales"
  }
]