[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals",
      "value": 2001
    }
  },
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_country",
      "operator": "equals",
      "value": "United States"
    }
  },
  {
    "operation": "dice",
    "dimensions": ["customer_demographics", "customer_address", "web_sales"],
    "filters": [
      {
        "logic": "OR",
        "conditions": [
          {
            "cd1.cd_marital_status": "W",
            "cd2.cd_marital_status": "W",
            "cd1.cd_education_status": "Primary",
            "cd2.cd_education_status": "Primary",
            "ws_sales_price_range": [100.00, 150.00]
          },
          {
            "cd1.cd_marital_status": "D",
            "cd2.cd_marital_status": "D",
            "cd1.cd_education_status": "Secondary",
            "cd2.cd_education_status": "Secondary",
            "ws_sales_price_range": [50.00, 100.00]
          },
          {
            "cd1.cd_marital_status": "M",
            "cd2.cd_marital_status": "M",
            "cd1.cd_education_status": "Advanced Degree",
            "cd2.cd_education_status": "Advanced Degree",
            "ws_sales_price_range": [150.00, 200.00]
          }
        ]
      }
    ]
  },
  {
    "operation": "dice",
    "dimensions": ["customer_address", "web_sales"],
    "filters": [
      {
        "logic": "OR",
        "conditions": [
          {
            "ca_state": ["KY", "ME", "IL"],
            "ws_net_profit_range": [100, 200]
          },
          {
            "ca_state": ["OK", "NE", "MN"],
            "ws_net_profit_range": [150, 300]
          },
          {
            "ca_state": ["FL", "WI", "KS"],
            "ws_net_profit_range": [50, 250]
          }
        ]
      }
    ]
  },
  {
    "operation": "roll-up",
    "dimension": "reason",
    "group_by": ["r_reason_desc"],
    "aggregations": [
      {
        "function": "AVG",
        "column": "ws_quantity"
      },
      {
        "function": "AVG",
        "column": "wr_refunded_cash"
      },
      {
        "function": "AVG",
        "column": "wr_fee"
      }
    ]
  },
  {
    "operation": "project",
    "attributes": [
      {
        "expression": "SUBSTR(r_reason_desc, 1, 20)",
        "alias": "reason_substr"
      },
      "AVG(ws_quantity)",
      "AVG(wr_refunded_cash)",
      "AVG(wr_fee)"
    ]
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "expression": "SUBSTR(r_reason_desc, 1, 20)",
        "direction": "ASC"
      },
      {
        "expression": "AVG(ws_quantity)",
        "direction": "ASC"
      },
      {
        "expression": "AVG(wr_refunded_cash)",
        "direction": "ASC"
      },
      {
        "expression": "AVG(wr_fee)",
        "direction": "ASC"
      }
    ]
  },
  {
    "operation": "limit",
    "count": 100
  }
]