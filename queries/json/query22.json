[
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_month_seq",
      "operator": "between",
      "value": [1205, 1216]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["item", "date_dim", "warehouse"],
    "description": "Select subcube with item, date, and warehouse dimensions based on the join conditions"
  },
  {
    "operation": "roll-up",
    "hierarchy": ["i_product_name", "i_brand", "i_class", "i_category"],
    "aggregation": {
      "measure": "inv_quantity_on_hand",
      "function": "average",
      "alias": "qoh"
    },
    "description": "Hierarchical roll-up generating subtotals at each level: all products -> by category -> by class -> by brand -> by product name"
  },
  {
    "operation": "sort",
    "order_by": [
      {"column": "qoh", "direction": "ascending"},
      {"column": "i_product_name", "direction": "ascending"},
      {"column": "i_brand", "direction": "ascending"},
      {"column": "i_class", "direction": "ascending"},
      {"column": "i_category", "direction": "ascending"}
    ]
  },
  {
    "operation": "limit",
    "value": 100
  }
]