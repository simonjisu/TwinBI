[
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_state",
      "operator": "in",
      "value": ["KS", "AZ", "NE"]
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 2004
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "between",
      "value": [3, 5]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["customer_demographics", "date"],
    "filters": [
      {
        "description": "customers with store sales in the specified period"
      },
      {
        "description": "customers without web sales in the specified period"
      },
      {
        "description": "customers without catalog sales in the specified period"
      }
    ]
  },
  {
    "operation": "roll-up",
    "dimensions": [
      "cd_gender",
      "cd_marital_status",
      "cd_education_status",
      "cd_purchase_estimate",
      "cd_credit_rating"
    ],
    "aggregations": [
      {
        "measure": "count",
        "alias": "cnt1"
      },
      {
        "measure": "count",
        "alias": "cnt2"
      },
      {
        "measure": "count",
        "alias": "cnt3"
      }
    ]
  },
  {
    "operation": "sort",
    "order_by": [
      "cd_gender",
      "cd_marital_status",
      "cd_education_status",
      "cd_purchase_estimate",
      "cd_credit_rating"
    ],
    "direction": "ascending"
  },
  {
    "operation": "limit",
    "value": 100
  }
]