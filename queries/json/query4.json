[
  {
    "operation": "slice",
    "dimension": "sale_type",
    "filter": {
      "column": "sale_type",
      "operator": "in",
      "value": ["s", "c", "w"]
    },
    "description": "Filter data for store sales, catalog sales, and web sales"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [2001, 2002]
    },
    "description": "Filter for years 2001 and 2002"
  },
  {
    "operation": "dice",
    "dimensions": ["customer", "date", "sale_type"],
    "filters": [
      {
        "column": "d_year",
        "operator": "in",
        "value": [2001, 2002]
      },
      {
        "column": "sale_type",
        "operator": "in",
        "value": ["s", "c", "w"]
      }
    ],
    "description": "Create a subcube with customer, year, and sale type dimensions"
  },
  {
    "operation": "roll-up",
    "dimensions": [
      "c_customer_id",
      "c_first_name",
      "c_last_name",
      "c_preferred_cust_flag",
      "c_birth_country",
      "c_login",
      "c_email_address",
      "d_year",
      "sale_type"
    ],
    "measure": "year_total",
    "aggregate_function": "sum",
    "description": "Aggregate sales data by customer attributes, year, and sale type"
  },
  {
    "operation": "slice",
    "dimension": "measure",
    "filter": {
      "column": "year_total",
      "operator": "greater_than",
      "value": 0
    },
    "description": "Filter customers with positive year_total in first year (2001) for all sale types"
  },
  {
    "operation": "pivot",
    "row_dimensions": ["customer_id", "customer_first_name", "customer_last_name", "customer_preferred_cust_flag"],
    "column_dimensions": ["sale_type", "dyear"],
    "measure": "year_total",
    "description": "Pivot data to compare year totals across sale types and years for each customer"
  },
  {
    "operation": "slice",
    "dimension": "calculated_measure",
    "filter": {
      "column": "catalog_growth_rate",
      "operator": "greater_than",
      "comparison": "store_growth_rate"
    },
    "description": "Filter customers where catalog sales growth rate exceeds store sales growth rate"
  },
  {
    "operation": "slice",
    "dimension": "calculated_measure",
    "filter": {
      "column": "catalog_growth_rate",
      "operator": "greater_than",
      "comparison": "web_growth_rate"
    },
    "description": "Filter customers where catalog sales growth rate exceeds web sales growth rate"
  },
  {
    "operation": "project",
    "attributes": [
      "customer_id",
      "customer_first_name",
      "customer_last_name",
      "customer_preferred_cust_flag"
    ],
    "description": "Select only customer identification attributes for final result"
  },
  {
    "operation": "sort",
    "dimensions": [
      "customer_id",
      "customer_first_name",
      "customer_last_name",
      "customer_preferred_cust_flag"
    ],
    "order": "ascending",
    "description": "Order results by customer attributes"
  },
  {
    "operation": "limit",
    "count": 100,
    "description": "Return top 100 results"
  }
]