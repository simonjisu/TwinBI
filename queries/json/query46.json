[
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_dow",
      "operator": "in",
      "value": [6, 0]
    }
  },
  {
    "operation": "slice",
    "dimension": "date_dim",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [2000, 2001, 2002]
    }
  },
  {
    "operation": "slice",
    "dimension": "store",
    "filter": {
      "column": "s_city",
      "operator": "in",
      "value": ["Midway", "Fairview"]
    }
  },
  {
    "operation": "dice",
    "dimension": "household_demographics",
    "filter": {
      "logical_operator": "or",
      "conditions": [
        {
          "column": "hd_dep_count",
          "operator": "equals",
          "value": 6
        },
        {
          "column": "hd_vehicle_count",
          "operator": "equals",
          "value": 0
        }
      ]
    }
  },
  {
    "operation": "roll-up",
    "dimensions": ["ss_ticket_number", "ss_customer_sk", "ss_addr_sk", "ca_city"],
    "measures": [
      {
        "column": "ss_coupon_amt",
        "aggregation": "sum",
        "alias": "amt"
      },
      {
        "column": "ss_net_profit",
        "aggregation": "sum",
        "alias": "profit"
      }
    ]
  },
  {
    "operation": "slice",
    "dimension": "customer_address",
    "filter": {
      "column": "ca_city",
      "operator": "not_equals",
      "value": "bought_city",
      "note": "Filter where current address city differs from purchase city"
    }
  },
  {
    "operation": "project",
    "attributes": [
      "c_last_name",
      "c_first_name",
      "ca_city",
      "bought_city",
      "ss_ticket_number",
      "amt",
      "profit"
    ]
  },
  {
    "operation": "sort",
    "order_by": [
      {"column": "c_last_name", "direction": "asc"},
      {"column": "c_first_name", "direction": "asc"},
      {"column": "ca_city", "direction": "asc"},
      {"column": "bought_city", "direction": "asc"},
      {"column": "ss_ticket_number", "direction": "asc"}
    ]
  },
  {
    "operation": "limit",
    "row_count": 100
  }
]