[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_month_seq",
      "operator": "between",
      "value": [1192, 1203]
    },
    "description": "Filter data for a 12-month period (months 1192 to 1203)"
  },
  {
    "operation": "dice",
    "dimensions": ["item", "date"],
    "filters": [
      {
        "column": "ws_item_sk",
        "operator": "is_not_null",
        "value": null
      },
      {
        "column": "ss_item_sk",
        "operator": "is_not_null",
        "value": null
      }
    ],
    "description": "Filter out records with null item keys in both web and store sales"
  },
  {
    "operation": "roll-up",
    "dimensions": ["item", "date"],
    "measures": [
      {
        "measure": "ws_sales_price",
        "aggregation": "sum"
      },
      {
        "measure": "ss_sales_price",
        "aggregation": "sum"
      }
    ],
    "description": "Aggregate sales prices by item and date for both channels"
  },
  {
    "operation": "custom_aggregation",
    "type": "cumulative_sum",
    "dimensions": ["item"],
    "measures": ["web_sales", "store_sales"],
    "window": {
      "partition_by": ["item_sk"],
      "order_by": ["d_date"],
      "frame": "rows_unbounded_preceding_to_current"
    },
    "description": "Calculate cumulative sales over time for each item"
  },
  {
    "operation": "custom_aggregation",
    "type": "running_maximum",
    "dimensions": ["item"],
    "measures": ["web_cumulative", "store_cumulative"],
    "window": {
      "partition_by": ["item_sk"],
      "order_by": ["d_date"],
      "frame": "rows_unbounded_preceding_to_current"
    },
    "description": "Calculate running maximum of cumulative sales for each item"
  },
  {
    "operation": "slice",
    "dimension": "comparison",
    "filter": {
      "column": "web_cumulative",
      "operator": "greater_than",
      "value": "store_cumulative"
    },
    "description": "Filter for items where web cumulative sales exceed store cumulative sales"
  },
  {
    "operation": "project",
    "dimensions": ["item_sk", "d_date"],
    "measures": ["web_sales", "store_sales", "web_cumulative", "store_cumulative"],
    "description": "Select specific dimensions and measures for output"
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "column": "item_sk",
        "direction": "ascending"
      },
      {
        "column": "d_date",
        "direction": "ascending"
      }
    ],
    "description": "Sort results by item and date"
  },
  {
    "operation": "limit",
    "value": 100,
    "description": "Return top 100 records"
  }
]