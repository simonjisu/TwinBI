[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 1998
    }
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "equals_to",
      "value": 12
    }
  },
  {
    "operation": "slice",
    "dimension": "item",
    "filter": {
      "column": "i_manager_id",
      "operator": "equals_to",
      "value": 38
    }
  },
  {
    "operation": "dice",
    "dimensions": ["customer_address", "store"],
    "filter": {
      "condition": "Substr(ca_zip, 1, 5) <> Substr(s_zip, 1, 5)",
      "description": "customer address zip code prefix does not match store zip code prefix"
    }
  },
  {
    "operation": "roll-up",
    "dimensions": ["i_brand_id", "i_brand", "i_manufact_id", "i_manufact"],
    "measure": "ss_ext_sales_price",
    "aggregation": "sum",
    "result_measure": "ext_price"
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "column": "ext_price",
        "direction": "DESC"
      },
      {
        "column": "i_brand",
        "direction": "ASC"
      },
      {
        "column": "i_brand_id",
        "direction": "ASC"
      },
      {
        "column": "i_manufact_id",
        "direction": "ASC"
      },
      {
        "column": "i_manufact",
        "direction": "ASC"
      }
    ]
  },
  {
    "operation": "limit",
    "value": 100
  }
]