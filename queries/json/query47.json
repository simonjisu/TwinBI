[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [1998, 1999, 2000]
    },
    "description": "Filter for year 1999 and its adjacent months (Dec 1998, Jan 2000)"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_moy",
      "operator": "conditional",
      "value": "d_moy=12 when d_year=1998, all months when d_year=1999, d_moy=1 when d_year=2000"
    },
    "description": "Filter specific months based on year condition"
  },
  {
    "operation": "dice",
    "dimensions": ["item_category", "item_brand", "store_name", "store_company", "date_year", "date_month"],
    "description": "Select subcube with product and store dimensions along with time granularity"
  },
  {
    "operation": "roll-up",
    "dimension": "date",
    "from_level": "day",
    "to_level": "month",
    "aggregate_function": "sum",
    "measure": "ss_sales_price",
    "group_by": ["i_category", "i_brand", "s_store_name", "s_company_name", "d_year", "d_moy"],
    "description": "Aggregate sales from daily to monthly level"
  },
  {
    "operation": "window_aggregation",
    "window_function": "avg",
    "measure": "sum_sales",
    "partition_by": ["i_category", "i_brand", "s_store_name", "s_company_name", "d_year"],
    "description": "Calculate average monthly sales within each year for product-store combination"
  },
  {
    "operation": "window_ranking",
    "window_function": "rank",
    "partition_by": ["i_category", "i_brand", "s_store_name", "s_company_name"],
    "order_by": ["d_year", "d_moy"],
    "description": "Rank months chronologically within each product-store combination"
  },
  {
    "operation": "temporal_lag_lead",
    "lag_periods": 1,
    "lead_periods": 1,
    "measure": "sum_sales",
    "description": "Get previous and next month sales for comparison"
  },
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "equals_to",
      "value": 1999
    },
    "description": "Final filter to focus on year 1999 only"
  },
  {
    "operation": "slice",
    "dimension": "measure",
    "filter": {
      "column": "avg_monthly_sales",
      "operator": "greater_than",
      "value": 0
    },
    "description": "Filter out records with zero average monthly sales"
  },
  {
    "operation": "slice",
    "dimension": "measure",
    "filter": {
      "column": "deviation_ratio",
      "operator": "greater_than",
      "value": 0.1,
      "formula": "abs(sum_sales - avg_monthly_sales) / avg_monthly_sales"
    },
    "description": "Filter for months with >10% deviation from average"
  },
  {
    "operation": "sort",
    "order_by": [
      {
        "column": "sum_sales - avg_monthly_sales",
        "direction": "ascending"
      },
      {
        "column": "d_moy",
        "direction": "ascending"
      }
    ],
    "description": "Order by sales deviation and month"
  },
  {
    "operation": "top_n",
    "n": 100,
    "description": "Limit results to top 100 records"
  }
]