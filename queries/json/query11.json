[
  {
    "operation": "slice",
    "dimension": "date",
    "filter": {
      "column": "d_year",
      "operator": "in",
      "value": [2001, 2002]
    }
  },
  {
    "operation": "slice",
    "dimension": "sales",
    "filter": {
      "column": "sale_type",
      "operator": "in",
      "value": ["s", "w"]
    }
  },
  {
    "operation": "dice",
    "dimensions": ["customer", "date", "sale_type"],
    "filters": [
      {
        "column": "d_year",
        "operator": "in",
        "value": [2001, 2002]
      },
      {
        "column": "sale_type",
        "operator": "in",
        "value": ["s", "w"]
      }
    ]
  },
  {
    "operation": "roll-up",
    "dimension": "sales",
    "grouping_attributes": [
      "c_customer_id",
      "c_first_name",
      "c_last_name",
      "c_preferred_cust_flag",
      "c_birth_country",
      "c_login",
      "c_email_address",
      "d_year",
      "sale_type"
    ],
    "aggregate_function": "SUM",
    "measure": "ss_ext_list_price - ss_ext_discount_amt"
  },
  {
    "operation": "slice",
    "dimension": "sales",
    "filter": {
      "column": "year_total",
      "operator": "greater_than",
      "value": 0
    }
  },
  {
    "operation": "pivot",
    "dimension": "date",
    "attributes": ["d_year"],
    "values": [2001, 2002],
    "purpose": "year_over_year_comparison"
  },
  {
    "operation": "pivot",
    "dimension": "sale_type",
    "attributes": ["sale_type"],
    "values": ["s", "w"],
    "purpose": "channel_comparison"
  },
  {
    "operation": "projection",
    "attributes": [
      "customer_id",
      "customer_first_name",
      "customer_last_name",
      "customer_birth_country"
    ]
  },
  {
    "operation": "sort",
    "attributes": [
      "customer_id",
      "customer_first_name",
      "customer_last_name",
      "customer_birth_country"
    ],
    "order": "ascending"
  },
  {
    "operation": "limit",
    "value": 100
  }
